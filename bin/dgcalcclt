#!/usr/bin/env sh
# Strict mode: Exit immediately on error (-e) or undefined variable (-u)
set -eu

# Print usage helper if no arguments are provided
if [ "$#" -lt 1 ]; then
  printf "[dgcalc] dg = %s\n" "$0"
  printf "[dgcalc] Usage: dg <task> [flags] [args...]\n"
  printf "[dgcalc] <task> = conf|make|run|runbin|runhere|what\n"
  printf "[dgcalc] [flags] = -t <builddir-tag> | -b <builddir>\n"
  exit 0
fi

# Extract the command (first argument) and shift it off the positional parameter list
cmd="$1"
shift

builddir="build"

# The colon after a letter (e.g., t:) means that flag requires an argument.
# Leading colon (:t:d:) enables silent error handling so we can catch invalid flags manually.
while getopts ":t:b:" opt; do
  case "$opt" in
    t)
      # Set a tag on the build directory, and use standard `build`
      builddir="$builddir-$OPTARG"
      ;;
    b)
      # Set the build directory explicitly
      builddir=$OPTARG
      ;;
    \?)
      echo "Error: Invalid option -$OPTARG" >&2
      exit 1
      ;;
    :)
      echo "Error: Option -$OPTARG requires an argument." >&2
      exit 1
      ;;
  esac
done

# Shift off the processed options so $1 points to the first positional argument
shift "$((OPTIND - 1))"

case "$cmd" in
  conf)
    printf "[dgcalc] conf: configure the cmake build system\n"
    # configure the CMakeLists.txt in ./ in directory /$builddir-<tag>/
    cmake -B "$builddir" -S . --fresh
    ;;

  make)
    printf "[dgcalc] make: make a specific target\n"
    # If you do not choose any, assume you want the "main" target.
    # You can get the behavior of `cmake --build <builddir>` by
    # invoking `dg make all`. This compiles the static library target,
    # the shared library target, and the main target (the test bench binary).
    if [ "$#" -lt 1 ]; then
      cmake --build "$builddir" --target main --parallel
    else
      cmake --build "$builddir" --target "$1" --parallel
    fi
    ;;

  runbin)
    printf "[dgcalc] runbin: run and bin output\n"
    cmake --build "$builddir" --target runbin --parallel
    ;;

  run)
    printf "[dgcalc] run: run and bin output\n"
    # an alias for runbin, which seems to be a good default run style.
    cmake --build "$builddir" --target runbin --parallel
    ;;

  runhere)
    printf "[dgcalc] runhere: run and do not bin output\n"
    cmake --build "$builddir" --target runhere --parallel
    ;;

  what)
    printf "[dgcalc] what: print available targets\n"
    cmake --build "$builddir" --target help --parallel
    ;;

  new)
    printf "[dgcalc] new: create a blank project\n"
    mkdir -p "$1/wrk/latest/pkg/inc"
    mkdir -p "$1/wrk/latest/pkg/src"
    mkdir -p "$1/share/static"
    mkdir -p "$1/share/lib"
    cp "$DGCALC_HOME/CMakeLists.txt" "$1/wrk/latest"
    cp "$DGCALC_HOME/main.cpp" "$1/wrk/latest"
    ;;

  *)
    printf "[dgcalc] Error: Unknown task command '%s'.\n" "$cmd" >&2
    exit 1
    ;;

esac
